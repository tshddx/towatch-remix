{
  "name": "towatch-remix",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-dev-env.mjs",
    "dev": "tsx watch --env-file=.env.development.local server.ts",
    "start": "tsx server.ts",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "remix": "^3.0.0-beta.0",
    "tsx": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "latest"
  }
}
